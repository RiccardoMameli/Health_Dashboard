# ---- Core -------------------------------------------------------------
# Postgres in production (Supabase). SQLite is fine for local dev/tests.
DATABASE_URL=postgresql+psycopg://user:pass@host:5432/health
TIMEZONE=Europe/London
ENVIRONMENT=development

# Single-user API auth. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
API_TOKEN=change-me

# ---- Hevy (plan 3.1) --------------------------------------------------
# Key from https://hevy.com/settings?developer  (requires Hevy Pro)
HEVY_API_KEY=
HEVY_BASE_URL=https://api.hevyapp.com

# ---- Withings (plan 3.2) ---------------------------------------------
# Register a personal app at https://developer.withings.com
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
WITHINGS_REDIRECT_URI=http://localhost:8000/api/v1/withings/callback

# ---- AI layer (Phase 2) ----------------------------------------------
ANTHROPIC_API_KEY=

# Phase-locked language (plan 9.2). baseline | associative | experimental.
# Leave on baseline: promotion is a deliberate act at Phase 5, not a timer.
BRIEF_PHASE=baseline

# ---- Brief delivery (plan 11) ----------------------------------------
RESEND_API_KEY=
BRIEF_EMAIL_TO=
BRIEF_EMAIL_FROM=brief@yourdomain.example
# Deep link the email's button points at (plan 7.3, anti-friction).
CHECKIN_URL=

# ---- Ops --------------------------------------------------------------
HEALTHCHECKS_PING_URL=

# ---- Metrics config (plan 6.2, O3) -----------------------------------
SLEEP_TARGET_MIN=450

# HRV is neither scored nor counted against completeness until it is verified
# on a real device (plan 3.3). Set true only once it actually arrives.
HRV_AVAILABLE=false

# Readiness weights (plan 6.3). Unset means the documented default; these are
# provisional and should be revisited once there is history to check them
# against how days actually felt.
# READINESS_W_SLEEP_DURATION=8
# READINESS_W_SLEEP_EFFICIENCY=4
# READINESS_W_RHR_DEVIATION=8
# READINESS_W_HRV_DEVIATION=7
# READINESS_W_SLEEP_DEBT=18
# READINESS_W_ACWR=9
# READINESS_W_SUBJECTIVE=7
